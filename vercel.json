{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/pw/(.*)",
      "destination": "/api/pw-proxy?endpoint=$1"
    },
    {
      "source": "/api/nts/(.*)",
      "destination": "https://nt.studyace.in/api/nig/$1"
    },
    {
      "source": "/api/nts",
      "destination": "https://nt.studyace.in/api/nig"
    },
    {
      "source": "/api/vc/(.*)",
      "destination": "https://nt.studyace.in/vc/$1"
    },
    {
      "source": "/api/studybee/batches.json",
      "destination": "/batches.json"
    },
    {
      "source": "/api/studybee/(.*)",
      "destination": "/batches.json"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
