{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/pw/(.*)",
      "destination": "/api/pw-proxy?endpoint=$1"
    },
    {
      "source": "/api/nts/(.*)",
      "destination": "https://nts.khatikgaurav38.workers.dev/$1"
    },
    {
      "source": "/api/vc/(.*)",
      "destination": "https://nt.studybeepro.site/vc/$1"
    },
    {
      "source": "/api/studybee/(.*)",
      "destination": "https://nt.studybeepro.site/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
